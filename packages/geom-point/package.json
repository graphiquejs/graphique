{
  "name": "@graphique/geom-point",
  "version": "2.0.2",
  "description": "For points, scatterplots, and bubbles",
  "keywords": [
    "react",
    "d3",
    "data-visualization",
    "grammar-of-graphics",
    "graphique",
    "scatterplot",
    "bubble-chart"
  ],
  "files": [
    "/src",
    "/dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "source": "./src/index.ts",
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graphiquejs/graphique.git"
  },
  "author": "Matt Adams",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint ./ --fix",
    "prepublishOnly": "npm run lint && npm run build",
    "typecheck": "attw --pack",
    "build": "tsup --minify",
    "watch": "tsup --watch"
  },
  "dependencies": {
    "d3-array": "^3.0.1",
    "d3-axis": "^3.0.0",
    "d3-ease": "^3.0.1",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.0",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "jotai": "^1.1.2",
    "react-move": "^6.5.0"
  },
  "peerDependencies": {
    "@graphique/graphique": ">=2",
    "react": ">=16",
    "react-dom": ">=16"
  },
  "devDependencies": {
    "@types/d3-array": "^3.0.1",
    "@types/d3-axis": "^3.0.1",
    "@types/d3-ease": "^3.0.0",
    "@types/d3-interpolate": "^3.0.0",
    "@types/d3-scale": "^4.0.0",
    "@types/d3-selection": "^3.0.0",
    "@types/d3-transition": "^3.0.1",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0"
  }
}
