{
  "name": "@graphique/datasets",
  "version": "2.0.0",
  "description": "A collection of datasets used in Graphique examples",
  "keywords": [
    "react",
    "d3",
    "data-visualization",
    "grammar-of-graphics",
    "graphique",
    "dataset"
  ],
  "files": [
    "/src",
    "/dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "source": "./src/index.ts",
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graphiquejs/graphique.git"
  },
  "author": "Matt Adams",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint ./ --fix",
    "prepublishOnly": "npm run lint && npm run build",
    "typecheck:src": "tsc --noEmit",
    "typecheck:build": "attw --pack",
    "docs:parse": "typedoc-json-parser",
    "docs:copy-readme": "cp README.md ../../docs/input/datasets/README.mdx",
    "docs:generateTypes": "quicktype ../../docs/input/datasets/api.json -o ../../docs/input/datasets/api.ts",
    "docs:prepare": "npm run docs:parse && npm run docs:copy-readme && npm run docs:generateTypes",
    "build": "tsup --minify --cjsInterop",
    "watch": "tsup --watch"
  }
}