{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "ES2021.String"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "jsx": "react",
    "types": ["@testing-library/jest-dom"]
  },
  "exclude": ["packages/**/node_modules", "docs/**/node_modules"]
}
