{cells:[{kind:1,language:'markdown',value:'## Graphique demos\n\nEspecially useful as a sandbox when developing Graphique. Enjoy!',metadata:{id:'3s0yb_fNPS_QKVU_kVJr3'}},{kind:1,language:'markdown',value:'---\n### GeomPoint basics\n\n_(hint: drag on the chart area)_',metadata:{id:'OjMMsFBM0OyGdgLEHfFvk'}},{kind:2,language:'typescriptreact',value:"import { GG, Labels } from '@graphique/graphique'\nimport { GeomPoint, Legend } from '@graphique/geom-point'\nimport { penguins } from '@graphique/datasets'\n\n// some shared components across examples\ninterface HeaderProps {\n  children?: React.ReactNode\n}\n\ninterface ContainerProps extends HeaderProps {\n  width?: number\n}\n\nconst Container = ({ width, children }: ContainerProps) => (\n  <div\n    style={{ width, height: 550, padding: 12 }}>\n    {children}\n  </div>\n)\n\nconst Header = ({ children }: HeaderProps) => (\n  <div style={{ display: 'flex', justifyContent: 'space-between' }}>\n    {children}\n  </div>\n)\n\nconst Penguins = () => (\n  <Container width={550}>\n    <GG\n      data={penguins}\n      aes={{\n        x: (d) => d.flipperLength,\n        y: (d) => d.bodyMass,\n        fill: (d) => d.species,\n      }}\n      margin={{ top: 20, left: 50 }}\n    >\n      <GeomPoint isClipped={false} brushAction='zoom' />\n      <Labels\n        header={\n          <Header>\n            🐧 Palmer Penguins\n            <Legend orientation='horizontal' />\n          </Header>\n        }\n        x='Flipper length (mm)'\n        y='Body mass (g)'\n      />\n    </GG>\n  </Container>\n);\n\n<Penguins />",metadata:{id:'eYYnSb3F1ZVzTaYzePTaq'}},{kind:1,language:'markdown',value:'---\n### GeomLine basics',metadata:{id:'4uJfYe3YpkC92TM-IKqrn'}},{kind:2,language:'typescriptreact',value:"import { GG } from '@graphique/graphique'\nimport { stocks } from '@graphique/datasets'\nimport { GeomLine, Legend } from '@graphique/geom-line'\n\nconst MarketCaps = () => (\n  <Container>\n    <GG\n      data={stocks}\n      aes={{\n        x: d => new Date(d.date),\n        y: d => d.marketCap,\n        stroke: d => d.symbol\n      }}\n      margin={{ left: 50 }}\n      isContainerWidth\n    >\n      <GeomLine brushAction='zoom' />\n      <Legend orientation='horizontal' />\n    </GG>\n  </Container>\n);\n\n<MarketCaps />",metadata:{id:'_b8Wx_m_kyjudwlCFPERT'}}]}